library(pacman)
pacman::p_load(tidyverse)
# ---------------------------
# PATHS
# ---------------------------
root_path <- "~/IGT_LLM_DecisionMaking"
results_dir <- file.path(root_path,
"src/3_simulation/WSLS/recovery/results/group_diff")
plot_dir <- file.path(results_dir, "plots")
dir.create(plot_dir, showWarnings = FALSE)
# ---------------------------
# CONSTANTS
# ---------------------------
GROUPS <- c("human", "gpt2023", "gpt2025")
GROUP_COLORS <- c(
human   = "#3498db",
gpt2023 = "#e74c3c",
gpt2025 = "#2ecc71"
)
CONTRAST_NAMES <- c(
gpt2023_human   = "GPT-2023 − Human",
gpt2025_human   = "GPT-2025 − Human",
gpt2025_gpt2023 = "GPT-2025 − GPT-2023"
)
CONTRAST_COLORS <- c("#e67e22", "#9b59b6", "#34495e")
PARAMS <- c("prob_stay_win", "prob_stay_lose", "epsilon")
PARAM_LABELS <- c(
prob_stay_win  = "P(Stay | Win)",
prob_stay_lose = "P(Stay | Lose)",
epsilon        = "Exploration (ε)"
)
probit_to_prob <- pnorm
ROPE_WIDTH <- 0.05  # in probability units now
# ---------------------------
# HELPERS
# ---------------------------
recovery_stats <- function(true, rec) {
c(
RMSE = sqrt(mean((rec - true)^2)),
Bias = mean(rec - true),
r    = cor(true, rec)
)
}
annotate_stats <- function(stats) {
txt <- sprintf(
"RMSE = %.2f\nBias = %.2f\nr = %.2f",
stats["RMSE"], stats["Bias"], stats["r"]
)
mtext(txt, side = 3, line = -1.5, adj = 1, cex = 0.9)
}
# ---------------------------
# LOAD DATA
# ---------------------------
results   <- read.csv(file.path(results_dir, "group_params_recovery.csv"))
contrasts <- read.csv(file.path(results_dir, "group_contrasts_recovery.csv"))
hyper     <- read.csv(file.path(results_dir, "group_hyperparams.csv"))
samples_list <- readRDS(file.path(results_dir, "samples_list.rds"))
true_params  <- readRDS(file.path(results_dir, "true_params.rds"))
# ================================================================
# 1. GROUP-LEVEL μ RECOVERY (prob space)
# ================================================================
png(file.path(plot_dir, "mu_recovery_by_group_prob.png"),
width = 2400, height = 800, res = 300)
par(mfrow = c(1, 3), mar = c(5,5,4,2), bg = "white")
for (param in PARAMS) {
true_vals <- probit_to_prob(results[[paste0("true_mu_", param)]])
rec_vals  <- probit_to_prob(results[[paste0("rec_mu_", param)]])
groups    <- results$group
lims  <- range(c(true_vals, rec_vals))
stats <- recovery_stats(true_vals, rec_vals)
plot(true_vals, rec_vals, type = "n",
main = PARAM_LABELS[param],
xlab = "True Probability",
ylab = "Recovered Probability",
xlim = lims, ylim = lims,
las = 1, bty = "l")
grid(col = "gray85")
for (g in GROUPS) {
idx <- groups == g
points(true_vals[idx], rec_vals[idx],
pch = 21,
bg = adjustcolor(GROUP_COLORS[g], 0.6),
col = GROUP_COLORS[g],
cex = 1.8)
}
abline(0, 1, lwd = 3, lty = 2)
annotate_stats(stats)
}
legend("topleft",
legend = c("Human", "GPT-2023", "GPT-2025"),
pch = 21,
pt.bg = GROUP_COLORS,
col = GROUP_COLORS,
bty = "n", cex = 1.2)
dev.off()
# ================================================================
# 2. GROUP CONTRAST RECOVERY (prob space)
# ================================================================
png(file.path(plot_dir, "group_contrast_recovery_prob.png"),
width = 2400, height = 800, res = 300)
par(mfrow = c(1, 3), mar = c(5,5,4,2), bg = "white")
for (param in PARAMS) {
cdat <- contrasts[contrasts$parameter == param, ]
true_mat <- sapply(1:3, function(i) probit_to_prob(cdat[[paste0("true_diff_", names(CONTRAST_NAMES)[i])]]))
rec_mat  <- sapply(1:3, function(i) probit_to_prob(cdat[[paste0("rec_diff_", names(CONTRAST_NAMES)[i])]]))
stats <- recovery_stats(as.vector(true_mat), as.vector(rec_mat))
lim <- range(c(true_mat, rec_mat))
plot(true_mat, rec_mat,
pch = 21,
bg = adjustcolor(rep(CONTRAST_COLORS, each = nrow(cdat)), 0.6),
col = rep(CONTRAST_COLORS, each = nrow(cdat)),
main = PARAM_LABELS[param],
xlab = "True Difference (prob)",
ylab = "Recovered Difference (prob)",
xlim = lim, ylim = lim,
las = 1, bty = "l")
grid(col = "gray85")
abline(0, 1, lwd = 3, lty = 2)
annotate_stats(stats)
}
legend("topleft",
legend = CONTRAST_NAMES,
pch = 21,
pt.bg = CONTRAST_COLORS,
col = CONTRAST_COLORS,
bty = "n", cex = 1.1)
dev.off()
# ================================================================
# 3. POSTERIOR-BASED CONTRAST RECOVERY (prob space)
# ================================================================
png(file.path(plot_dir, "posterior_contrast_recovery_prob.png"),
width = 3600, height = 3600, res = 300)
par(mfrow = c(3, 3), mar = c(4,4,3,1), oma = c(2,2,2,2), bg = "white")
for (param in PARAMS) {
param_name <- paste0("mu_", param, "_raw")
for (i in seq_along(CONTRAST_NAMES)) {
cname <- names(CONTRAST_NAMES)[i]
gidx  <- switch(cname,
gpt2023_human   = c(2,1),
gpt2025_human   = c(3,1),
gpt2025_gpt2023 = c(3,2))
post_diffs <- sapply(seq_along(samples_list), function(sim) {
sims <- probit_to_prob(samples_list[[sim]][[param_name]])
sims[, gidx[1]] - sims[, gidx[2]]
})
post_diffs <- as.vector(post_diffs)
true_diff <- probit_to_prob(true_params[[GROUPS[gidx[1]]]]$mu[paste0(param, "_raw")]) -
probit_to_prob(true_params[[GROUPS[gidx[2]]]]$mu[paste0(param, "_raw")])
prob_correct_sign <- mean(sign(post_diffs) == sign(true_diff))
rope_mass <- mean(abs(post_diffs - true_diff) < ROPE_WIDTH)
hist(post_diffs,
breaks = 40,
col = adjustcolor(CONTRAST_COLORS[i], 0.6),
border = "white",
main = paste(PARAM_LABELS[param], "\n", CONTRAST_NAMES[i]),
xlab = "Posterior Difference (prob)",
las = 1)
abline(v = true_diff, lwd = 3)
abline(v = true_diff + c(-ROPE_WIDTH, ROPE_WIDTH), lty = 2)
legend("topright",
legend = c(
sprintf("P(correct sign) = %.2f", prob_correct_sign),
sprintf("ROPE mass = %.2f", rope_mass)
),
bty = "n", cex = 1.0)
}
}
dev.off()
cat("All plots converted to probability space complete.\n")
