geom_density(alpha=0.4) +
scale_fill_manual(values=c("ahn_hc"="black","gpt_OLD_2023"="blue","gpt_NEW_2025"="red")) +
labs(title="Posterior predictive check: net scores across groups",
x="Net score (C+D minus A+B)", y="Density") +
theme_minimal()
ggsave(file.path(ppc_dir, "trial_level_net_score.png"), net_score_plot, width=10, height=6, dpi=300)
# Win-stay / lose-shift plot
ws_ls_plot <- ggplot(sim_summaries_long, aes(x=value, fill=group)) +
geom_density(alpha=0.4) +
