mean(stay & reward[-1] > 0, na.rm=TRUE)
},
lose_shift = {
choices <- deck
stay <- c(NA, choices[-1] == choices[-length(choices)])
mean(!stay & reward[-1] < 0, na.rm=TRUE)
}
)
}
