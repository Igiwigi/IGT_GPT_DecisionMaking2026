n_sims <- dim(x_pred)[1]
# ===== Define summary statistics =====
calc_deck_props <- function(choices, ntrials) {
props <- matrix(NA, nrow = nsubs, ncol = 4)
for (s in 1:nsubs) {
for (deck in 1:4) {
props[s, deck] <- sum(choices[s, 1:ntrials[s]] == deck) / ntrials[s]
}
}
return(props)
}
calc_switches <- function(choices, ntrials) {
switches <- numeric(nsubs)
for (s in 1:nsubs) {
switches[s] <- sum(choices[s, 1:(ntrials[s]-1)] != choices[s, 2:ntrials[s]])
}
return(switches)
}
calc_good_deck_trend <- function(choices, ntrials, n_blocks = 5) {
trends <- matrix(NA, nrow = nsubs, ncol = n_blocks)
for (s in 1:nsubs) {
block_size <- ntrials[s] / n_blocks
for (b in 1:n_blocks) {
start_idx <- floor((b-1) * block_size) + 1
end_idx <- floor(b * block_size)
trends[s, b] <- mean(choices[s, start_idx:end_idx] %in% c(3, 4))
}
}
return(trends)
}
# ---- Observed statistics ----
obs_deck_props <- calc_deck_props(x_obs, ntrials)
obs_switches <- calc_switches(x_obs, ntrials)
obs_trends <- calc_good_deck_trend(x_obs, ntrials)
# ---- Predicted statistics ----
pred_deck_props <- array(NA, dim = c(n_sims, nsubs, 4))
pred_switches <- matrix(NA, nrow = n_sims, ncol = nsubs)
pred_trends <- array(NA, dim = c(n_sims, nsubs, 5))
for (i in 1:n_sims) {
pred_deck_props[i,,] <- calc_deck_props(x_pred[i,,], ntrials)
pred_switches[i,] <- calc_switches(x_pred[i,,], ntrials)
pred_trends[i,,] <- calc_good_deck_trend(x_pred[i,,], ntrials)
}
# ===== Visualization =====
plot_dir <- file.path(root_path, "src", "2_estimation", "plots", "new_model")
# Deck proportions
plot_data <- data.frame()
for (deck in 1:4) {
obs_df <- data.frame(deck = paste0("Deck", LETTERS[deck]),
proportion = obs_deck_props[,deck],
type = "Observed")
pred_mean <- colMeans(pred_deck_props[,,deck])
pred_df <- data.frame(deck = paste0("Deck", LETTERS[deck]),
proportion = pred_mean,
type = "Predicted")
plot_data <- rbind(plot_data, obs_df, pred_df)
}
p1 <- ggplot(plot_data, aes(x = deck, y = proportion, fill = type)) +
geom_boxplot() +
labs(title = paste("PPC: Deck Selection -", group_name),
y = "Proportion", x = "Deck") +
theme_minimal()
ggsave(file.path(plot_dir, paste0("PPC_deck_props_", model_tag, "_", group_name, ".png")),
p1, width = 8, height = 6)
# Switches
switch_data <- data.frame(
switches = c(obs_switches, as.vector(pred_switches)),
type = c(rep("Observed", nsubs), rep("Predicted", n_sims*nsubs))
)
p2 <- ggplot(switch_data, aes(x = switches, fill = type)) +
geom_density(alpha = 0.5) +
labs(title = paste("PPC: Deck Switches -", group_name),
x = "Number of Switches", y = "Density") +
theme_minimal()
ggsave(file.path(plot_dir, paste0("PPC_switches_", model_tag, "_", group_name, ".png")),
p2, width = 8, height = 6)
# Good deck trend
trend_data <- data.frame()
for (block in 1:5) {
obs_df <- data.frame(block = block,
proportion = obs_trends[,block],
type = "Observed")
pred_mean <- colMeans(pred_trends[,,block])
pred_df <- data.frame(block = block,
proportion = pred_mean,
type = "Predicted")
trend_data <- rbind(trend_data, obs_df, pred_df)
}
p3 <- ggplot(trend_data, aes(x = block, y = proportion, color = type, group = type)) +
geom_point() + geom_line() +
labs(title = paste("PPC: Good Deck Trend -", group_name),
x = "Block", y = "Proportion of Good Decks (C,D)") +
theme_minimal()
ggsave(file.path(plot_dir, paste0("PPC_trends_", model_tag, "_", group_name, ".png")),
p3, width = 8, height = 6)
# ---- Bayesian p-values ----
calc_bayesian_pval <- function(obs_stat, pred_stats) {
mean(pred_stats >= obs_stat)
}
obs_total_switches <- sum(obs_switches)
pred_total_switches <- rowSums(pred_switches)
pval_switches <- calc_bayesian_pval(obs_total_switches, pred_total_switches)
print(paste0("Bayesian p-value for total switches:", pval_switches, "\n"))
print("(Values close to 0.5 indicate good fit!!!)")
