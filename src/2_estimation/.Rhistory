# ---- Settings ----
root_path <- "~/IGT_LLM_DecisionMaking"
groups <- c("ahn_hc", "gpt_OLD_2023", "gpt_NEW_2025")
group_name <- groups[1]
fixed_theta <- TRUE
model_tag <- ifelse(fixed_theta, "fixedTheta", "freeTheta")
# ---- Load fitted JAGS model ----
fitfile <- file.path(root_path, "src", "2_estimation", "results", "new_model",
paste0("jags_fit_", model_tag, "_", group_name, ".RData"))
load(fitfile)
# ---- Load observed data ----
data_file <- file.path(root_path, "data", "final_data", paste0("clean_", group_name, ".csv"))
data <- read.csv(data_file)
# ---- Prepare data arrays ----
subIDs <- unique(data$subjID)
nsubs <- length(subIDs)
x_raw <- data$x
X_raw <- data$X
ntrials_max <- 100
x_obs <- array(0, c(nsubs, ntrials_max))
X <- array(0, c(nsubs, ntrials_max))
ntrials <- numeric(nsubs)
for (s in 1:nsubs) {
ntrials[s] <- sum(data$subjID == subIDs[s])
x_obs[s,] <- x_raw[data$subjID == subIDs[s]]
X[s,] <- X_raw[data$subjID == subIDs[s]]
}
X <- X / 100  # scale payoffs
# ---- Extract posterior predictive choices ----
x_pred <- samples$BUGSoutput$sims.list$x_pred  # n_sims x nsubs x ntrials
n_sims <- dim(x_pred)[1]
# ===== Define summary statistics =====
calc_deck_props <- function(choices, ntrials) {
props <- matrix(NA, nrow = nsubs, ncol = 4)
for (s in 1:nsubs) {
for (deck in 1:4) {
