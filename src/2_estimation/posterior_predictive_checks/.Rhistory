simulated_data <- list()
for(g in groups){
posterior_sample <- param_list[[g]][
sample(1:nrow(param_list[[g]]), nsub_per_group, replace=TRUE), ]
simulated_data[[g]] <- simulate_igt(posterior_sample, ntrials=ntrials, payoffs_matrix=payoffs_matrix)
simulated_data[[g]]$group <- g
}
