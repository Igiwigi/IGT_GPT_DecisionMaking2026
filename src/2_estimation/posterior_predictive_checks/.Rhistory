signX <- ifelse(X[t]>=0, 1, -1)
for(d in 1:ndeck){
Ef_cho <- Ef_prev[d] + ifelse(X[t]>=0, a_rew, a_pun)*(signX - Ef_prev[d])
Ef_not <- Ef_prev[d] + ifelse(X[t]>=0, a_pun, a_rew)*(-(signX/3)-Ef_prev[d])
Ef_curr[d] <- ifelse(d==x[t], Ef_cho, Ef_not)
}
