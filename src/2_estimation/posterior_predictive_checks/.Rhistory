Ef_prev <- rep(0, ndeck)
PS_prev <- rep(1, ndeck)
x <- numeric(ntrials)
X <- numeric(ntrials)
for(t in 1:ntrials){
# Compute V and choice probabilities
V <- Ev_prev + Ef_prev*omega_f + PS_prev*omega_p
V <- pmin(pmax(V, -700), 700)  # prevent overflow
exp_p <- exp(theta*V)
if(sum(exp_p)==0) exp_p <- rep(1, ndeck)
p <- exp_p / sum(exp_p)
# Draw choice
x[t] <- sample(1:ndeck, 1, prob=p)
X[t] <- payoffs_matrix[t, x[t]]
