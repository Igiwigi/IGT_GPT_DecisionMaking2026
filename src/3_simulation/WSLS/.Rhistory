# -------------------------------
# Paths and group names
# -------------------------------
root_path <- "~/IGT_LLM_DecisionMaking"
groups <- c("ahn_hc", "gpt_OLD_2023", "gpt_NEW_2025")  # human → old → new
# -------------------------------
# Load group-level posterior draws
# -------------------------------
param_list <- list()
for(g in groups){
param_file <- file.path(root_path, "src", "2_estimation", "results",
"simpler_models", paste0("param_estimated_WSLS_", g, ".csv"))
param_list[[g]] <- read.csv(param_file)
}
# -------------------------------
# Function to simulate synthetic subjects (WSLS model)
# -------------------------------
simulate_subjects_wsls <- function(params, nsub=500){
# Sample one posterior draw
row <- params[sample(1:nrow(params), 1), ]
# Convert precisions to SDs
sigma_prob_stay_win <- 1 / sqrt(max(row$lambda_prob_stay_win, 1e-6))
sigma_prob_stay_lose <- 1 / sqrt(max(row$lambda_prob_stay_lose, 1e-6))
sigma_epsilon <- 1 / sqrt(max(row$lambda_epsilon, 1e-6))
# Simulate subject-level parameters on raw (probit) scale
prob_stay_win_raw <- rnorm(nsub, mean=qnorm(row$mu_prob_stay_win), sd=sigma_prob_stay_win)
prob_stay_lose_raw <- rnorm(nsub, mean=qnorm(row$mu_prob_stay_lose), sd=sigma_prob_stay_lose)
epsilon_raw <- rnorm(nsub, mean=qnorm(row$mu_epsilon), sd=sigma_epsilon)
# Transform to [0,1] using probit inverse (pnorm)
prob_stay_win <- pnorm(prob_stay_win_raw)
prob_stay_lose <- pnorm(prob_stay_lose_raw)
epsilon <- pnorm(epsilon_raw)
df <- data.frame(prob_stay_win, prob_stay_lose, epsilon)
return(df)
}
# -------------------------------
# Simulate synthetic subjects per group (average across multiple draws)
# -------------------------------
n_draws <- 50    # number of posterior draws to average over
nsub <- 500      # subjects per draw
sim_list <- list()
sd_list <- list()
for(g in groups){
param_df <- param_list[[g]]
# Store all simulated subjects across draws
sim_all <- list()
sd_matrix <- matrix(NA, nrow=n_draws, ncol=3)
colnames(sd_matrix) <- c("prob_stay_win", "prob_stay_lose", "epsilon")
for(i in 1:n_draws){
sim <- simulate_subjects_wsls(param_df, nsub=nsub)
sim_all[[i]] <- sim
sd_matrix[i,] <- apply(sim, 2, sd)
}
# Combine all draws for posterior predictive plot
sim_list[[g]] <- bind_rows(sim_all)
# Store mean SD and SD of SDs for error bars
sd_list[[g]] <- data.frame(
parameter = colnames(sd_matrix),
mean_SD = apply(sd_matrix, 2, mean),
SD_of_SD = apply(sd_matrix, 2, sd)
)
}
# -------------------------------
# Combine all groups into one long data frame
# -------------------------------
sim_df_all <- bind_rows(
lapply(groups, function(g){
df <- sim_list[[g]]
df$group <- g
df
})
)
# -------------------------------
# Save simulated subject-level parameters to CSV
# -------------------------------
save_file <- file.path(root_path, "src", "2_estimation",
"posterior_predictive_checks", "parameter_level",
"simulated_subjects_all_parameters_WSLS_model.csv")
if(!dir.exists(dirname(save_file))) dir.create(dirname(save_file), recursive = TRUE)
write.csv(sim_df_all, save_file, row.names=FALSE)
cat("Simulated subject-level parameters saved to:\n", save_file, "\n")
# -------------------------------
# Plot posterior predictive densities for all parameters
# -------------------------------
sim_df_long <- sim_df_all %>%
pivot_longer(cols = c(prob_stay_win, prob_stay_lose, epsilon),
names_to = "parameter",
values_to = "value")
# Create more interpretable parameter labels
sim_df_long$parameter <- factor(sim_df_long$parameter,
levels = c("prob_stay_win", "prob_stay_lose", "epsilon"),
labels = c("P(Stay|Win)", "P(Stay|Lose)", "Exploration (ε)"))
plot_all <- ggplot(sim_df_long, aes(x=value, color=group)) +
geom_density(size=1) +
facet_wrap(~parameter, scales="free") +
theme_bw() +
labs(title="Parameter posterior predictive distributions across groups (WSLS MODEL)",
x="Parameter value",
y="Density") +
scale_color_manual(values=c("ahn_hc"="black", "gpt_OLD_2023"="blue", "gpt_NEW_2025"="red")) +
theme(text=element_text(size=14),
legend.title=element_blank())
plot_file <- file.path(root_path, "src", "2_estimation", "WSLS",
"posterior_predictive_checks", "parameter_level",
"posterior_predictive_all_parameters_WSLS_model.png")
ggsave(plot_file, plot_all, width=12, height=6, dpi=400)
# Posterior Predictive Simulation for WSLS Model (PARAMETER LEVEL)
# Simulates synthetic subjects from hierarchical posterior draws
# Saves simulated subject-level parameters to CSV
# Load required packages
pacman::p_load(ggplot2, dplyr, tidyr)
set.seed(2026)
# -------------------------------
# Paths and group names
# -------------------------------
root_path <- "~/IGT_LLM_DecisionMaking"
groups <- c("ahn_hc", "gpt_OLD_2023", "gpt_NEW_2025")  # human → old → new
# -------------------------------
# Load group-level posterior draws
# -------------------------------
param_list <- list()
for(g in groups){
param_file <- file.path(root_path, "src", "2_estimation", "results",
"simpler_models", paste0("param_estimated_WSLS_", g, ".csv"))
param_list[[g]] <- read.csv(param_file)
}
# -------------------------------
# Function to simulate synthetic subjects (WSLS model)
# -------------------------------
simulate_subjects_wsls <- function(params, nsub=500){
# Sample one posterior draw
row <- params[sample(1:nrow(params), 1), ]
# Convert precisions to SDs
sigma_prob_stay_win <- 1 / sqrt(max(row$lambda_prob_stay_win, 1e-6))
sigma_prob_stay_lose <- 1 / sqrt(max(row$lambda_prob_stay_lose, 1e-6))
sigma_epsilon <- 1 / sqrt(max(row$lambda_epsilon, 1e-6))
# Simulate subject-level parameters on raw (probit) scale
prob_stay_win_raw <- rnorm(nsub, mean=qnorm(row$mu_prob_stay_win), sd=sigma_prob_stay_win)
prob_stay_lose_raw <- rnorm(nsub, mean=qnorm(row$mu_prob_stay_lose), sd=sigma_prob_stay_lose)
epsilon_raw <- rnorm(nsub, mean=qnorm(row$mu_epsilon), sd=sigma_epsilon)
# Transform to [0,1] using probit inverse (pnorm)
prob_stay_win <- pnorm(prob_stay_win_raw)
prob_stay_lose <- pnorm(prob_stay_lose_raw)
epsilon <- pnorm(epsilon_raw)
df <- data.frame(prob_stay_win, prob_stay_lose, epsilon)
return(df)
}
# -------------------------------
# Simulate synthetic subjects per group (average across multiple draws)
# -------------------------------
n_draws <- 50    # number of posterior draws to average over
nsub <- 500      # subjects per draw
sim_list <- list()
sd_list <- list()
for(g in groups){
param_df <- param_list[[g]]
# Store all simulated subjects across draws
sim_all <- list()
sd_matrix <- matrix(NA, nrow=n_draws, ncol=3)
colnames(sd_matrix) <- c("prob_stay_win", "prob_stay_lose", "epsilon")
for(i in 1:n_draws){
sim <- simulate_subjects_wsls(param_df, nsub=nsub)
sim_all[[i]] <- sim
sd_matrix[i,] <- apply(sim, 2, sd)
}
# Combine all draws for posterior predictive plot
sim_list[[g]] <- bind_rows(sim_all)
# Store mean SD and SD of SDs for error bars
sd_list[[g]] <- data.frame(
parameter = colnames(sd_matrix),
mean_SD = apply(sd_matrix, 2, mean),
SD_of_SD = apply(sd_matrix, 2, sd)
)
}
# -------------------------------
# Combine all groups into one long data frame
# -------------------------------
sim_df_all <- bind_rows(
lapply(groups, function(g){
df <- sim_list[[g]]
df$group <- g
df
})
)
# -------------------------------
# Save simulated subject-level parameters to CSV
# -------------------------------
save_file <- file.path(root_path, "src", "2_estimation",
"posterior_predictive_checks", "parameter_level",
"simulated_subjects_all_parameters_WSLS_model.csv")
if(!dir.exists(dirname(save_file))) dir.create(dirname(save_file), recursive = TRUE)
write.csv(sim_df_all, save_file, row.names=FALSE)
cat("Simulated subject-level parameters saved to:\n", save_file, "\n")
# -------------------------------
# Plot posterior predictive densities for all parameters
# -------------------------------
sim_df_long <- sim_df_all %>%
pivot_longer(cols = c(prob_stay_win, prob_stay_lose, epsilon),
names_to = "parameter",
values_to = "value")
# Create more interpretable parameter labels
sim_df_long$parameter <- factor(sim_df_long$parameter,
levels = c("prob_stay_win", "prob_stay_lose", "epsilon"),
labels = c("P(Stay|Win)", "P(Stay|Lose)", "Exploration (ε)"))
plot_all <- ggplot(sim_df_long, aes(x=value, color=group)) +
geom_density(size=1) +
facet_wrap(~parameter, scales="free") +
theme_bw() +
labs(title="Parameter posterior predictive distributions across groups (WSLS MODEL)",
x="Parameter value",
y="Density") +
scale_color_manual(values=c("ahn_hc"="black", "gpt_OLD_2023"="blue", "gpt_NEW_2025"="red")) +
theme(text=element_text(size=14),
legend.title=element_blank())
plot_file <- file.path(root_path, "src", "2_estimation",
"posterior_predictive_checks", "parameter_level",
"posterior_predictive_all_parameters_WSLS_model.png")
ggsave(plot_file, plot_all, width=12, height=6, dpi=400)
cat("Density plot saved to:\n", plot_file, "\n")
# -------------------------------
# Visualize subject-level SDs with error bars
# -------------------------------
sd_table_all <- bind_rows(
lapply(names(sd_list), function(g){
df <- sd_list[[g]]
df$group <- g
df
})
)
# Order factors with interpretable labels
sd_table_all$parameter <- factor(sd_table_all$parameter,
levels = c("prob_stay_win", "prob_stay_lose", "epsilon"),
labels = c("P(Stay|Win)", "P(Stay|Lose)", "Exploration (ε)"))
sd_table_all$group <- factor(sd_table_all$group,
levels=c("ahn_hc","gpt_OLD_2023","gpt_NEW_2025"))
# Plot
sd_plot <- ggplot(sd_table_all, aes(x=parameter, y=mean_SD, fill=group)) +
geom_bar(stat="identity", position=position_dodge(width=0.8), color="black") +
geom_errorbar(aes(ymin=mean_SD - SD_of_SD, ymax=mean_SD + SD_of_SD),
width=0.2, position=position_dodge(width=0.8)) +
scale_fill_manual(values=c("ahn_hc"="black", "gpt_OLD_2023"="blue", "gpt_NEW_2025"="red")) +
theme_minimal() +
labs(title="Subject-level SDs for WSLS parameters",
x="Parameter",
y="Mean SD ± SD of SDs") +
theme(text=element_text(size=14),
legend.title=element_blank())
plot_file_sd <- file.path(root_path, "src", "2_estimation",
"posterior_predictive_checks", "parameter_level",
"subject_level_SD_plot_WSLS_model.png")
ggsave(plot_file_sd, sd_plot, width=10, height=6, dpi=400)
sd_plot
# -------------------------------
# Posterior parameter correlation / identifiability plots
# -------------------------------
if(!require(pacman)) install.packages("pacman")
pacman::p_load(ggplot2, bayesplot)
# -------------------------------
# Paths and groups
# -------------------------------
root_path <- "~/IGT_LLM_DecisionMaking"
groups <- c("ahn_hc", "gpt_OLD_2023", "gpt_NEW_2025")
param_path <- file.path(root_path, "src/2_estimation/results/simpler_models")
cor_dir <- file.path(root_path, "src/2_estimation/posterior_predictive_checks/parameter_correlations")
if(!dir.exists(cor_dir)) dir.create(cor_dir, recursive = TRUE)
# -------------------------------
# Load posterior draws for each group
# -------------------------------
param_list <- lapply(groups, function(g){
file <- file.path(param_path, paste0("param_estimated_WSLS_", g, ".csv"))
if(!file.exists(file)) stop("Posterior file not found: ", file)
read.csv(file)
})
names(param_list) <- groups
# -------------------------------
# Generate and save pairs plots
# -------------------------------
for(g in groups){
cat("Posterior pairs plot for group:", g, "\n")
posterior_sample <- param_list[[g]][1:min(1000, nrow(param_list[[g]])), ]  # subset for clarity
# Select WSLS parameters of interest
param_cols <- c("mu_prob_stay_win", "mu_prob_stay_lose", "mu_epsilon",
"sigma_prob_stay_win", "sigma_prob_stay_lose", "sigma_epsilon")
# Check which columns actually exist in the data
available_cols <- param_cols[param_cols %in% colnames(posterior_sample)]
if(length(available_cols) == 0){
warning("No matching parameter columns found for group ", g,
". Available columns: ", paste(colnames(posterior_sample), collapse=", "))
next
}
posterior_mat <- as.matrix(posterior_sample[, available_cols])
posterior_array <- array(posterior_mat,
dim = c(nrow(posterior_mat), 1, ncol(posterior_mat)))
dimnames(posterior_array) <- list(NULL, "chain1", colnames(posterior_mat))
# Create more readable column names for plotting
colnames(posterior_mat) <- gsub("mu_prob_stay_win", "μ(Stay|Win)", colnames(posterior_mat))
colnames(posterior_mat) <- gsub("mu_prob_stay_lose", "μ(Stay|Lose)", colnames(posterior_mat))
colnames(posterior_mat) <- gsub("mu_epsilon", "μ(ε)", colnames(posterior_mat))
colnames(posterior_mat) <- gsub("sigma_prob_stay_win", "σ(Stay|Win)", colnames(posterior_mat))
colnames(posterior_mat) <- gsub("sigma_prob_stay_lose", "σ(Stay|Lose)", colnames(posterior_mat))
colnames(posterior_mat) <- gsub("sigma_epsilon", "σ(ε)", colnames(posterior_mat))
dimnames(posterior_array)[[3]] <- colnames(posterior_mat)
# Generate the pairs plot
pairs_plot <- mcmc_pairs(
posterior_array,
diag_fun = "hist",
off_diag_fun = "scatter",
off_diag_args = list(alpha = 0.3, size = 0.5)
)
# Save plot
ggsave(
filename = file.path(cor_dir, paste0("posterior_pairs_WSLS_", g, ".png")),
plot = pairs_plot,
width = 12, height = 10, dpi = 300
)
cat("  Saved to:", file.path(cor_dir, paste0("posterior_pairs_WSLS_", g, ".png")), "\n")
}
cat("\nAll pairs plots generated successfully!\n")
# ============================================================================
# POSTERIOR PREDICTIVE CHECK FOR WSLS MODEL
# Focus: Switches, Win-Stay/Lose-Switch
# ============================================================================
pacman::p_load(R2jags, ggplot2, dplyr, gridExtra)
# ---- Settings ----
root_path <- "~/IGT_LLM_DecisionMaking"
groups <- c("ahn_hc", "gpt_OLD_2023", "gpt_NEW_2025")
group_name <- groups[3] # which group to do PPC on
# ---- Load data ----
fitfile <- file.path(root_path, "src", "2_estimation", "results", "simpler_models",
paste0("jags_fit_WSLS_", group_name, ".RData"))
load(fitfile)
data_file <- file.path(root_path, "data", "final_data", paste0("clean_", group_name, ".csv"))
data <- read.csv(data_file)
# ---- Prepare arrays ----
subIDs <- unique(data$subjID)
nsubs <- length(subIDs)
ntrials_max <- 100
x_obs <- array(0, c(nsubs, ntrials_max))
X <- array(0, c(nsubs, ntrials_max))
ntrials <- numeric(nsubs)
for (s in 1:nsubs) {
ntrials[s] <- sum(data$subjID == subIDs[s])
x_obs[s,] <- data$x[data$subjID == subIDs[s]]
X[s,] <- data$X[data$subjID == subIDs[s]]
}
X <- X / 100
# Extract predictions
x_pred <- samples$BUGSoutput$sims.list$x_pred
n_sims <- dim(x_pred)[1]
plot_dir <- file.path(root_path, "src", "2_estimation",
"posterior_predictive_checks", "posterior_predictive_plots")
dir.create(plot_dir, recursive = TRUE, showWarnings = FALSE)
# ============================================================================
# STATISTIC 1: SWITCHES
# ============================================================================
calc_switches <- function(choices, ntrials) {
switches <- numeric(nsubs)
for (s in 1:nsubs) {
switches[s] <- sum(choices[s, 1:(ntrials[s]-1)] != choices[s, 2:ntrials[s]])
}
return(switches)
}
obs_switches <- calc_switches(x_obs, ntrials)
pred_switches <- t(apply(x_pred, 1, calc_switches, ntrials = ntrials))
# Bayesian p-value
obs_total <- sum(obs_switches)
pred_total <- rowSums(pred_switches)
pval_switches <- mean(pred_total >= obs_total)
# Plot
p1 <- ggplot() +
geom_histogram(aes(x = pred_total), fill = "skyblue", alpha = 0.6, bins = 50) +
geom_vline(xintercept = obs_total, color = "red", size = 1.5, linetype = "dashed") +
annotate("text", x = obs_total, y = Inf,
label = sprintf("Obs = %d\np = %.3f", obs_total, pval_switches),
vjust = 1.5, hjust = -0.1, color = "red", fontface = "bold", size = 5) +
labs(title = paste("Total Switches (WSLS Model):", group_name),
x = "Total Switches", y = "Count") +
theme_bw(base_size = 14)
ggsave(file.path(plot_dir, paste0("switches_WSLS_", group_name, ".png")),
p1, width = 8, height = 6)
# ============================================================================
# STATISTIC 2: WIN-STAY / LOSE-SWITCH PROBABILITIES
# ============================================================================
calc_wsls <- function(choices, outcomes, ntrials) {
# outcomes: X matrix (payoffs/100)
# Returns matrix: [nsubs x 4] with win-stay, win-switch, lose-stay, lose-switch probs
wsls <- matrix(NA, nrow = nsubs, ncol = 4)
colnames(wsls) <- c("win_stay", "win_switch", "lose_stay", "lose_switch")
for (s in 1:nsubs) {
n <- ntrials[s]
if (n < 2) next
win_stay <- 0
win_switch <- 0
lose_stay <- 0
lose_switch <- 0
for (t in 1:(n-1)) {
current_choice <- choices[s, t]
next_choice <- choices[s, t+1]
outcome <- outcomes[s, t]
stayed <- (current_choice == next_choice)
won <- (outcome > 0)  # simple win = positive outcome
if (won) {
if (stayed) {
win_stay <- win_stay + 1
} else {
win_switch <- win_switch + 1
}
} else {  # lost
if (stayed) {
lose_stay <- lose_stay + 1
} else {
lose_switch <- lose_switch + 1
}
}
}
# Calculate probabilities
total_wins <- win_stay + win_switch
total_losses <- lose_stay + lose_switch
if (total_wins > 0) {
wsls[s, "win_stay"] <- win_stay / total_wins
wsls[s, "win_switch"] <- win_switch / total_wins
}
if (total_losses > 0) {
wsls[s, "lose_stay"] <- lose_stay / total_losses
wsls[s, "lose_switch"] <- lose_switch / total_losses
}
}
return(wsls)
}
# Calculate for observed data
obs_wsls <- calc_wsls(x_obs, X, ntrials)
# Calculate for predicted data
pred_wsls <- array(NA, dim = c(n_sims, nsubs, 4))
for (i in 1:n_sims) {
pred_wsls[i,,] <- calc_wsls(x_pred[i,,], X, ntrials)
}
# win stay lose switch, prepare data
wsls_plot_data <- data.frame(
Strategy = rep(c("Win-Stay", "Lose-Switch"), each = nsubs * 2),
Probability = c(
obs_wsls[, 1],  # win_stay
colMeans(pred_wsls[,, 1], na.rm = TRUE),  # win_stay
obs_wsls[, 4],  # lose_switch
colMeans(pred_wsls[,, 4], na.rm = TRUE)  # lose_switch
),
Type = rep(rep(c("Observed", "Predicted"), each = nsubs), 2)
)
# Remove NAs
wsls_plot_data <- wsls_plot_data[!is.na(wsls_plot_data$Probability), ]
p4 <- ggplot(wsls_plot_data, aes(x = Strategy, y = Probability, fill = Type)) +
geom_boxplot(alpha = 0.7, outlier.alpha = 0.3) +
scale_fill_manual(values = c("Observed" = "coral", "Predicted" = "skyblue")) +
ylim(0, 1) +
labs(title = paste("Win-Stay / Lose-Switch (WSLS Model):", group_name),
y = "Probability", x = "") +
theme_bw(base_size = 14) +
theme(legend.position = "top")
ggsave(file.path(plot_dir, paste0("wsls_WSLS_", group_name, ".png")),
p4, width = 8, height = 6)
# ============================================================================
# SUMMARY REPORT
# ============================================================================
summary_file <- file.path(root_path, "src", "2_estimation",
"posterior_predictive_checks", "posterior_predictive_plots",
paste0("PPC_summary_WSLS_", group_name, ".txt"))
sink(summary_file)
cat("\n===============================================\n")
cat("POSTERIOR PREDICTIVE CHECK SUMMARY\n")
cat("===============================================\n")
cat("Group:", group_name, "\n")
cat("Model: WSLS (Win-Stay-Lose-Shift)\n\n")
cat("IF p value is <0.05 or >0.95, there is a significant mismatch between model and data!\n\n")
cat("SWITCHES:\n")
cat(sprintf("  Observed total: %d\n", obs_total))
cat(sprintf("  Predicted mean: %.1f [%.1f, %.1f]\n",
mean(pred_total),
quantile(pred_total, 0.025),
quantile(pred_total, 0.975)))
cat(sprintf("  Bayesian p-value: %.3f", pval_switches))
if (pval_switches < 0.05 || pval_switches > 0.95) {
cat(" *")
}
cat("\n")
cat("\nWIN-STAY / LOSE-SWITCH:\n")
obs_ws_mean <- mean(obs_wsls[, "win_stay"], na.rm = TRUE)
obs_ls_mean <- mean(obs_wsls[, "lose_switch"], na.rm = TRUE)
pred_ws_means <- rowMeans(pred_wsls[,, 1], na.rm = TRUE)
pred_ls_means <- rowMeans(pred_wsls[,, 4], na.rm = TRUE)
pval_ws <- mean(pred_ws_means >= obs_ws_mean)
pval_ls <- mean(pred_ls_means >= obs_ls_mean)
cat(sprintf("  Win-Stay:    Obs=%.3f, Pred=%.3f [%.3f, %.3f], p=%.3f",
obs_ws_mean,
mean(pred_ws_means),
quantile(pred_ws_means, 0.025),
quantile(pred_ws_means, 0.975),
pval_ws))
if (pval_ws < 0.05 || pval_ws > 0.95) {
cat(" *")
}
cat("\n")
cat(sprintf("  Lose-Switch: Obs=%.3f, Pred=%.3f [%.3f, %.3f], p=%.3f",
obs_ls_mean,
mean(pred_ls_means),
quantile(pred_ls_means, 0.025),
quantile(pred_ls_means, 0.975),
pval_ls))
if (pval_ls < 0.05 || pval_ls > 0.95) {
cat(" *")
}
cat("\n")
sink()
cat("Summary saved to:", summary_file, "\n")
